# Variables de production ImmoLib — copier vers production.env HORS Git et
# remplacer toutes les valeurs. Les lignes vides/commentées sont optionnelles.
# Cross-reference : apps/api/.env.example (dev), infrastructure/render.yaml
# (Render), infra README.md (procédure complète).

# --- Base ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_ALLOWED_HOSTS=app.immolib.ci,www.immolib.ci
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.immolib.ci,https://www.immolib.ci
PUBLIC_APP_URL=https://app.immolib.ci
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
EXPOSE_TEST_OTP=false
DJANGO_SESSION_COOKIE_AGE_SECONDS=604800

# Base de donnees : DATABASE_URL (Render/Neon/Supabase) OU les POSTGRES_*
# (auto-hébergé docker compose). DATABASE_URL a priorite en production.
# DATABASE_URL=postgres://immolib:motdepasse@db:5432/immolib
DATABASE_ENGINE=postgresql
POSTGRES_DB=immolib
POSTGRES_USER=immolib
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cache partage (verrouillage connexion, throttles) : obligatoire des que
# plusieurs workers gunicorn tournent. Redis est fourni par compose.yaml
# (redis://redis:6379/0) ou par Render (service immolib-redis, auto-injecte).
# REDIS_URL=redis://redis:6379/0

# --- Monitoring (Sentry) ---
# SENTRY_DSN=https://cle@o4500000000.ingest.sentry.io/4500000000
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=1.0.0
# Duree (min) au-dela de laquelle une notification QUEUED sans adaptateur
# configuree est signalee comme bloquee par /api/v1/health/ (503).
# IMMOLIB_HEALTH_QUEUE_STALL_MINUTES=15

# --- Sauvegarde (commande backup_database, voir README.md) ---
# Destination prioritaire : Amazon S3 (chiffrement SSE-S3).
# BACKUP_S3_BUCKET=immolib-backups-prod
# Passphrase optionnelle pour un chiffrement AES-256-CBC supplementaire
# (BACKUP_PASSPHRASE ou BACKUP_PASSPHRASE_FILE, comme backup.sh).
# BACKUP_PASSPHRASE=replace-with-a-long-passphrase
# BACKUP_DIR=/opt/immolib/backups
# BACKUP_RETENTION_DAYS=14

# --- Amazon SES (emails OTP, quittances partagees, rappels) ---
# Les identifiants AWS suivent la chaine standard boto3 : env, profil ou role.
IMMOLIB_EMAIL_NOTIFICATION_ADAPTER=modules.notifications.adapters.AmazonSesEmailAdapter
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-key
AWS_SES_REGION=af-south-1
AWS_SES_FROM_EMAIL=no-reply@immolib.ci

# --- Web Push (VAPID) : paire generee hors depot (voir docs) ---
IMMOLIB_PUSH_NOTIFICATION_ADAPTER=modules.notifications.adapters.WebPushVapidAdapter
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:contact@immolib.ci

# --- WhatsApp Business Cloud API. Le verify token doit correspondre au champ
# "Vérifier le token" du dashboard Meta (URL de rappel :
# https://votre-domaine/backend/webhooks/whatsapp/). Access token et phone
# number id proviennent du dashboard Meta (WhatsApp > Configuration).
IMMOLIB_WHATSAPP_NOTIFICATION_ADAPTER=modules.notifications.adapters.WhatsAppCloudApiAdapter
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-your-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-your-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
WHATSAPP_API_VERSION=v24.0

# --- Orange SMS (Côte d'Ivoire). Credentials dans "MyApps" du portail Orange
# Developer (docs/sms/orange.md). URL du webhook DR :
# https://votre-domaine/backend/api/v1/webhooks/sms/orange/
IMMOLIB_SMS_NOTIFICATION_ADAPTER=modules.sms.adapters.OrangeSmsAdapter
ORANGE_SMS_CLIENT_ID=replace-with-your-client-id
ORANGE_SMS_CLIENT_SECRET=replace-with-your-client-secret
ORANGE_SMS_BASE_URL=https://api.orange.com
ORANGE_SMS_SENDER_ADDRESS=tel:+2250000
ORANGE_SMS_SENDER_NAME=IMMOLIB
ORANGE_SMS_TIMEOUT_SECONDS=10
ORANGE_SMS_DR_ALLOWED_IPS=1.2.3.4,5.6.7.8
ORANGE_SMS_COST_PER_SEGMENT_XOF=10
IMMOLIB_SMS_RATE_PER_SECOND=5
IMMOLIB_SMS_MAX_CHARS=160

# --- Webhook Mobile Money ---
MOBILE_MONEY_WEBHOOK_SECRET=replace-with-your-webhook-secret
MOBILE_MONEY_WEBHOOK_TOLERANCE_SECONDS=300

# --- Abonnements PayDunya (agregateur mobile money / cartes) ---
# En production : PAYDUNYA_MODE=live et IMMOLIB_SUBSCRIPTIONS_PILOT_MODE=false.
IMMOLIB_SUBSCRIPTIONS_PILOT_MODE=false
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=replace-with-your-master-key
PAYDUNYA_PRIVATE_KEY=replace-with-your-private-key
PAYDUNYA_PUBLIC_KEY=replace-with-your-public-key
PAYDUNYA_TOKEN=replace-with-your-token
PAYDUNYA_STORE_NAME=ImmoLib
PAYDUNYA_CALLBACK_URL=https://app.immolib.ci/backend/api/v1/webhooks/paydunya/

# Prix et limites des plans (defauts : essentiel 2000 FCFA, pro 4000 FCFA).
# ESSENTIAL_PRICE=2000
# ESSENTIAL_MAX_HOUSES=5
# PRO_PRICE=4000
# PRO_MAX_HOUSES=15
# FREE_MAX_HOUSES=1