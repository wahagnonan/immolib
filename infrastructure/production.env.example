DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=immolib.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://immolib.example.com
PUBLIC_APP_URL=https://immolib.example.com
DATABASE_ENGINE=postgresql
POSTGRES_DB=immolib
POSTGRES_USER=immolib
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
EXPOSE_TEST_OTP=false

# WhatsApp Business Cloud API. Le verify token doit correspondre au champ
# "Vérifier le token" du dashboard Meta (URL de rappel :
# https://votre-domaine/backend/webhooks/whatsapp/). Access token et phone
# number id proviennent du dashboard Meta (WhatsApp > Configuration).
IMMOLIB_WHATSAPP_NOTIFICATION_ADAPTER=modules.notifications.adapters.WhatsAppCloudApiAdapter
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-your-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-your-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
WHATSAPP_API_VERSION=v24.0
