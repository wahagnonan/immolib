DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_COOKIE_SECURE=false

# SQLite est utilise par defaut en local et pour l'apprentissage.
# Pour PostgreSQL, definir DATABASE_ENGINE=postgresql puis les variables ci-dessous.
DATABASE_ENGINE=sqlite
POSTGRES_DB=immolib
POSTGRES_USER=immolib
POSTGRES_PASSWORD=immolib
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

PUBLIC_APP_URL=http://localhost:3000
EXPOSE_TEST_OTP=false
# Codes de compte : 10 minutes, un renvoi par minute et cinq essais.
IMMOLIB_ACCOUNT_OTP_LIFETIME_SECONDS=600
IMMOLIB_ACCOUNT_OTP_COOLDOWN_SECONDS=60
IMMOLIB_ACCOUNT_OTP_MAX_ATTEMPTS=5
IMMOLIB_DOCUMENT_OTP_COOLDOWN_SECONDS=60
# Duree d'un lien d'invitation locataire avant expiration.
IMMOLIB_TENANT_INVITATION_LIFETIME_DAYS=14

# Adaptateurs de notification. Laisser vide garde les messages dans la file.
IMMOLIB_SMS_NOTIFICATION_ADAPTER=
IMMOLIB_EMAIL_NOTIFICATION_ADAPTER=modules.notifications.adapters.AmazonSesEmailAdapter
IMMOLIB_WHATSAPP_NOTIFICATION_ADAPTER=
IMMOLIB_PUSH_NOTIFICATION_ADAPTER=modules.notifications.adapters.FirebasePushAdapter
AWS_SES_REGION=af-south-1
AWS_SES_FROM_EMAIL=no-reply@votre-domaine.ci
FIREBASE_PROJECT_ID=
# Chemin absolu vers un fichier monte hors du depot, ou laisser vide pour ADC.
FIREBASE_CREDENTIALS_FILE=
IMMOLIB_NOTIFICATION_MAX_ATTEMPTS=3
IMMOLIB_NOTIFICATION_RETRY_SECONDS=60
IMMOLIB_NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
# Rappels a J-3, jour J, J+3 et J+7. AUTO privilegie push puis email.
IMMOLIB_RENT_REMINDER_OFFSETS_DAYS=-3,0,3,7
IMMOLIB_RENT_REMINDER_CHANNELS=AUTO

# Webhook Mobile Money generique. Ne jamais versionner le secret reel.
# Signature attendue : HMAC-SHA256 de "<timestamp>.<corps HTTP brut>".
MOBILE_MONEY_WEBHOOK_SECRET=
MOBILE_MONEY_WEBHOOK_TOLERANCE_SECONDS=300

# Frontend Next.js
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
