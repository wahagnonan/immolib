# Variables d'environnement du backend ImmoLib (copier vers .env)
# Aucun secret reel ne doit etre committe. Consulter docs/sms/orange.md.

DJANGO_SECRET_KEY=unsafe-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_APP_URL=http://localhost:3000
DATABASE_ENGINE=sqlite
EXPOSE_TEST_OTP=false

# --- Notifications --------------------------------------------------------
# Chaque canal utilise un adaptateur interchangeable. En developpement, le
# mode simulation est actif par defaut (aucun fournisseur contacte).
# IMMOLIB_SMS_NOTIFICATION_ADAPTER=modules.sms.adapters.OrangeSmsAdapter
# IMMOLIB_EMAIL_NOTIFICATION_ADAPTER=modules.notifications.adapters.AmazonSesEmailAdapter
# IMMOLIB_WHATSAPP_NOTIFICATION_ADAPTER=modules.notifications.adapters.WhatsAppCloudApiAdapter
# IMMOLIB_PUSH_NOTIFICATION_ADAPTER=modules.notifications.adapters.WebPushVapidAdapter

# --- Orange SMS (Cote d'Ivoire) -------------------------------------------
# Credentials obtenus dans "MyApps" du portail Orange Developer apres
# souscription a l'API SMS Cote d'Ivoire et achat d'un bundle.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_BASE_URL=https://api.orange.com
# Sender address officielle CI (table country_sender_number de la doc Orange).
ORANGE_SMS_SENDER_ADDRESS=tel:+2250000
# Sender name optionnel (11 caracteres alphanumeriques max, whiteliste par
# Orange via le formulaire https://developer.orange.com/sms-api-queries/).
ORANGE_SMS_SENDER_NAME=IMMOLIB
ORANGE_SMS_TIMEOUT_SECONDS=10
# IP publiques autorisees a appeler le webhook de Delivery Receipt (IPs
# transmises par l'equipe Orange apres declaration de l'URL). Vide = ouvert.
ORANGE_SMS_DR_ALLOWED_IPS=
# Cout estime d'un segment en FCFA (tarif des bundles Orange).
ORANGE_SMS_COST_PER_SEGMENT_XOF=10
# Limite officielle Orange : 5 SMS par seconde.
IMMOLIB_SMS_RATE_PER_SECOND=5
# Longueur maximale d'un segment GSM-7.
IMMOLIB_SMS_MAX_CHARS=160

# --- Amazon SES -----------------------------------------------------------
# Les identifiants AWS suivent la chaine standard boto3 (env, profil, role).
AWS_SES_REGION=af-south-1
AWS_SES_FROM_EMAIL=
# ARN du topic SNS qui recoit les evenements SES (bounce/complaint). Vide =
# le webhook /api/v1/webhooks/email/ses/ repond 503 et n'accepte rien.
# Consulter docs/email/configuration.md pour la mise en place (SPF/DKIM/DMARC).
AWS_SES_SNS_TOPIC_ARN=
# Configuration set SES reference dans chaque envoi (obligatoire pour publier
# les evenements bounce/complaint sur le topic SNS). Vide = pas d'evenements.
AWS_SES_CONFIGURATION_SET=

# --- Web Push (VAPID) -----------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- WhatsApp Business Cloud API ------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v24.0

# --- PI-SPI BCEAO (Model B via PSP participant) ---------------------------
# ImmoLib n'est pas participant direct. En sandbox, le mock simule sans PSP.
# En live, renseigner PI_SPI_PSP_BASE_URL + PI_SPI_PSP_API_KEY + PI_SPI_WEBHOOK_SECRET.
PI_SPI_ENABLED=true
PI_SPI_MODE=sandbox
PI_SPI_PSP_BASE_URL=
PI_SPI_PSP_API_KEY=
PI_SPI_WEBHOOK_SECRET=
PI_SPI_WEBHOOK_TOLERANCE_SECONDS=300
PI_SPI_TIMEOUT_SECONDS=15
PI_SPI_MOCK_ENABLED=true
PI_SPI_MOCK_AUTO_SUCCESS=false
PI_SPI_TRANSACTION_TTL_SECONDS=900

# --- Webhook Mobile Money -------------------------------------------------
MOBILE_MONEY_WEBHOOK_SECRET=

# --- Abonnements PayDunya -------------------------------------------------
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
IMMOLIB_SUBSCRIPTIONS_PILOT_MODE=true
ESSENTIAL_PRICE=2000
ESSENTIAL_MAX_HOUSES=5
PRO_PRICE=4000
PRO_MAX_HOUSES=15
